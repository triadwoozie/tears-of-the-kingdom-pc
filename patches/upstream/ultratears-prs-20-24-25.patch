+    (void)b;
+    (void)c;
+}
+
+static uint32_t f2u32(float v) {
+    uint32_t u;
+    memcpy(&u, &v, 4);
+    return u;
+}
+
+static float u32f(uint32_t u) {
+    float v;
+    memcpy(&v, &u, 4);
