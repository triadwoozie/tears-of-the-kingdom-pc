diff --git a/src/runtime/dispatch.c b/src/runtime/dispatch.c
index 50de728..8147f64 100644
--- a/src/runtime/dispatch.c
+++ b/src/runtime/dispatch.c
@@ -257,3 +257,82 @@ void fnprof_hit(uint64_t addr, uint64_t lr, uint64_t x0) { (void)addr; (void)lr;
 
 // ---- CNTPCT_EL0: the Switch's 19.2 MHz system counter
 uint64_t rt_ticks(void) { return (uint64_t)((unsigned __int128)plat_now_ns() * 12 / 625); }
+
+// ---- Direct-call linker wrapper & fallback arena for sead::Heap::alloc (f_80006a920)
+// and sead::HeapMgr::getCurrentHeap (f_802bb74c0)
+void __real_f_80006a920(Cpu *c) __attribute__((weak));
+void __real_f_802bb74c0(Cpu *c) __attribute__((weak));
+
+static void *dispatch_fallback_heap_alloc(uint64_t size, uint64_t alignment) {
+    static pthread_mutex_t s_fallback_lock = PTHREAD_MUTEX_INITIALIZER;
+    static uint8_t *s_fallback_arena = NULL;
+    static uint64_t s_fallback_used = 0;
+    const uint64_t ARENA_SIZE = 32ULL << 20;  // 32 MiB fallback arena
+
+    if (!size) size = 0x230;
+    if (alignment < 8) alignment = 8;
+
+    pthread_mutex_lock(&s_fallback_lock);
+    if (!s_fallback_arena) {
+        s_fallback_arena = (uint8_t *)hle_alloc(ARENA_SIZE);
+    }
+    uint64_t cur = (uint64_t)(uintptr_t)(s_fallback_arena + s_fallback_used);
+    uint64_t aligned = (cur + (alignment - 1)) & ~(alignment - 1);
+    uint64_t new_used = (aligned - (uint64_t)(uintptr_t)s_fallback_arena) + size;
+    void *ptr = NULL;
+    if (new_used <= ARENA_SIZE) {
+        s_fallback_used = new_used;
+        ptr = (void *)(uintptr_t)aligned;
+        memset(ptr, 0, (size_t)size);
+    } else {
+        fprintf(stderr, "[totk] WARNING: sead::Heap fallback arena exhausted (%llu bytes requested)\n",
+                (unsigned long long)size);
+    }
+    pthread_mutex_unlock(&s_fallback_lock);
+    return ptr;
+}
+
+void __wrap_f_80006a920(Cpu *c) {
+    // If heap context in x1 is NULL or points to an invalid/unmapped range:
+    if (c->x[1] == 0 || c->x[1] < 0x10000ULL || c->x[1] >= (1ULL << 48)) {
+        uint64_t sz = c->x[0] ? c->x[0] : 0x230;
+        uint64_t align = c->x[2] ? c->x[2] : 16;
+        void *p = dispatch_fallback_heap_alloc(sz, align);
+        c->x[0] = (uint64_t)(uintptr_t)p;
+        fprintf(stderr, "[totk] sead::Heap::alloc direct-call intercept: invalid heap x1=%#llx -> fallback arena %#llx (size=%llu, lr=%#llx)\n",
+                (unsigned long long)c->x[1], (unsigned long long)c->x[0], (unsigned long long)sz, (unsigned long long)c->x[30]);
+        return;
+    }
+    if (__real_f_80006a920) {
+        __real_f_80006a920(c);
+    } else {
+        c->x[0] = 0;
+    }
+    if (c->x[0] == 0) {
+        uint64_t sz = 0x230;
+        uint64_t align = 16;
+        void *p = dispatch_fallback_heap_alloc(sz, align);
+        c->x[0] = (uint64_t)(uintptr_t)p;
+        fprintf(stderr, "[totk] sead::Heap::alloc returned NULL -> fallback arena rescue %#llx (lr=%#llx)\n",
+                (unsigned long long)c->x[0], (unsigned long long)c->x[30]);
+    }
+}
+
+void __wrap_f_802bb74c0(Cpu *c) {
+    if (__real_f_802bb74c0) {
+        __real_f_802bb74c0(c);
+    } else {
+        c->x[0] = 0;
+    }
+    if (c->x[0] == 0 || c->x[0] < 0x10000ULL || c->x[0] >= (1ULL << 48)) {
+        static uint8_t s_default_heap[1024] __attribute__((aligned(64)));
+        c->x[0] = (uint64_t)(uintptr_t)s_default_heap;
+        fprintf(stderr, "[totk] sead::HeapMgr::getCurrentHeap returned NULL -> substituted fallback heap %#llx (lr=%#llx)\n",
+                (unsigned long long)c->x[0], (unsigned long long)c->x[30]);
+    }
+}
+
+__attribute__((constructor)) static void install_heap_alloc_wrappers(void) {
+    hle_override(0x080006a920ull, __wrap_f_80006a920, "sead::Heap::alloc");
+    hle_override(0x0802bb74c0ull, __wrap_f_802bb74c0, "sead::HeapMgr::getCurrentHeap");
+}
